generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  DEALER
  ADMIN
}

enum DealerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  SHIPPED
  DELIVERED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  admin        Admin?
  dealer       Dealer?
  customer     Customer?
  addresses    Address[]
  orders       Order[]
  carts        Cart[]
  auditLogs    AuditLog[]
}

model Admin {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dealer {
  id          String        @id @default(cuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  gstin       String?
  status      DealerStatus  @default(PENDING)
  approvedAt  DateTime?
  prices      DealerPrice[]
  quotations  Quotation[]

  @@index([status])
}

model Customer {
  id     String  @id @default(cuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name   String
  phone  String
  email  String
  orders Order[]

  @@index([email])
}

model Address {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  phone    String
  line1    String
  line2    String?
  city     String
  state    String
  pinCode  String
  country  String  @default("IN")
}

model Category {
  id                    String     @id @default(cuid())
  name                  String
  slug                  String     @unique
  parentId              String?
  parent                Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children              Category[] @relation("CategoryTree")
  products              Product[]
  specificationTemplate Json       @default("{}")

  @@index([parentId])
}

model Product {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  sku                   String                 @unique
  categoryId            String
  category              Category               @relation(fields: [categoryId], references: [id])
  description           String
  mrp                   Decimal?               @db.Decimal(12, 2)
  sellingPrice          Decimal                @db.Decimal(12, 2)
  wholesalePrice        Decimal?               @db.Decimal(12, 2)
  gstRate               Decimal?               @db.Decimal(5, 2)
  minimumOrderQuantity  Int?
  sourceId              String?                @unique
  sourceSku             String?
  sourceUrl             String?
  sourceData            Json?
  sourceCollectionSlugs String[]               @default([])
  warranty              String?
  datasheetUrl          String?
  shippingInfo          String?
  published             Boolean                @default(false)
  archived              Boolean                @default(false)
  featured              Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  images                ProductImage[]
  variants              ProductVariant[]
  specifications        ProductSpecification[]
  dealerPrices          DealerPrice[]

  @@index([categoryId, published, archived])
  @@index([createdAt])
}

model ProductImage {
  id                 String  @id @default(cuid())
  productId          String
  product            Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url                String
  cloudinaryPublicId String? @unique
  sourceAssetId      String? @unique
  alt                String
  sortOrder          Int     @default(0)

  @@index([productId, sortOrder])
}

model ProductVariant {
  sourceId        String?         @unique
  sourceSku       String?
  sourceAvailable Boolean?
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku             String          @unique
  name            String
  attributes      Json
  sellingPrice    Decimal         @db.Decimal(12, 2)
  inventory       Inventory?
  cartItems       CartItem[]
  orderItems      OrderItem[]
  quotationItems  QuotationItem[]

  @@index([productId])
}

model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
  unit      String?

  @@unique([productId, key])
  @@index([key, value])
}

model Inventory {
  id                String         @id @default(cuid())
  variantId         String         @unique
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity          Int            @default(0)
  reserved          Int            @default(0)
  lowStockThreshold Int            @default(0)
  version           Int            @default(0)
  updatedAt         DateTime       @updatedAt
}

model DealerPrice {
  id              String  @id @default(cuid())
  dealerId        String
  dealer          Dealer  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice       Decimal @db.Decimal(12, 2)
  minimumQuantity Int

  @@unique([dealerId, productId, minimumQuantity])
}

model Cart {
  id             String     @id @default(cuid())
  userId         String?
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestTokenHash String?    @unique
  items          CartItem[]
  createdAt      DateTime   @default(now())
  expiresAt      DateTime

  @@index([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int

  @@unique([cartId, variantId])
}

model Order {
  id               String         @id @default(cuid())
  number           String         @unique
  idempotencyKey   String         @unique
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerId       String
  customer         Customer       @relation(fields: [customerId], references: [id])
  customerSnapshot Json
  deliveryAddress  Json
  companyName      String?
  gstin            String?
  notes            String?
  status           OrderStatus    @default(PENDING)
  subtotal         Decimal        @db.Decimal(12, 2)
  gst              Decimal        @db.Decimal(12, 2)
  shipping         Decimal        @db.Decimal(12, 2)
  discount         Decimal        @db.Decimal(12, 2)
  total            Decimal        @db.Decimal(12, 2)
  currency         String         @default("INR")
  couponId         String?
  coupon           Coupon?        @relation(fields: [couponId], references: [id])
  items            OrderItem[]
  payments         Payment[]
  shipments        Shipment[]
  notifications    Notification[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  name            String
  sku             String
  variantSnapshot Json
  quantity        Int
  unitPrice       Decimal        @db.Decimal(12, 2)
  gstRate         Decimal        @db.Decimal(5, 2)
  gstAmount       Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)

  @@index([orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  method            String
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  verifiedAt        DateTime?
  createdAt         DateTime      @default(now())

  @@index([orderId, status])
}

model PaymentWebhookEvent {
  id          String    @id
  payloadHash String
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Quotation {
  id        String          @id @default(cuid())
  number    String          @unique
  dealerId  String?
  dealer    Dealer?         @relation(fields: [dealerId], references: [id])
  contact   Json
  status    String          @default("REQUESTED")
  notes     String?
  expiresAt DateTime?
  createdAt DateTime        @default(now())
  items     QuotationItem[]
}

model QuotationItem {
  id          String          @id @default(cuid())
  quotationId String
  quotation   Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  description String
  quantity    Int
  unitPrice   Decimal?        @db.Decimal(12, 2)
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  type            String
  value           Decimal  @db.Decimal(12, 2)
  minimumSubtotal Decimal  @db.Decimal(12, 2)
  maxDiscount     Decimal? @db.Decimal(12, 2)
  usageLimit      Int?
  usedCount       Int      @default(0)
  startsAt        DateTime
  expiresAt       DateTime
  active          Boolean  @default(false)
  orders          Order[]
}

model Notification {
  id                String                 @id @default(cuid())
  orderId           String
  order             Order                  @relation(fields: [orderId], references: [id])
  channel           String
  recipient         String
  template          String
  payload           Json
  dedupeKey         String                 @unique
  status            NotificationStatus     @default(PENDING)
  attempts          Int                    @default(0)
  nextAttemptAt     DateTime               @default(now())
  lockedAt          DateTime?
  providerMessageId String?
  lastError         String?
  createdAt         DateTime               @default(now())
  deliveries        NotificationDelivery[]

  @@index([status, nextAttemptAt])
  @@index([orderId])
}

model NotificationDelivery {
  id                String       @id @default(cuid())
  notificationId    String
  notification      Notification @relation(fields: [notificationId], references: [id])
  attempt           Int
  status            String
  error             String?
  providerMessageId String?
  createdAt         DateTime     @default(now())

  @@unique([notificationId, attempt])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id])
  carrier        String
  trackingNumber String
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  @@index([orderId])
}

model SiteSettings {
  id        String   @id @default("main")
  content   Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  changes    Json
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model CatalogueImport {
  id                String   @id @default(cuid())
  sourceName        String
  sourceHash        String   @unique
  approvalReference String
  status            String   @default("STAGED")
  validationErrors  Json
  createdAt         DateTime @default(now())
}

model CatalogueSnapshot {
  id         String   @id
  sourceUrl  String
  sourceHash String
  importedAt DateTime
  payload    Json
}
